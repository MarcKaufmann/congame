cket/format\n         racket/match\n         racket/port\n         web-server/http)\n\n(provide\n (rename-out\n  [form+combine form]\n  [congame:formular-autofill bot:autofill]\n  [congame:submit-button submit-button])\n form+submit\n dyn:form\n (all-from-out forms) ;; all except form (exported as dyn:form avove)\n make-autofill\n\n errors\n checkbox\n checkboxes\n input-date\n input-datetime\n input-email\n input-file\n input-number\n input-range\n input-text\n input-time\n radio\n radios\n select\n textarea\n\n required-unless\n at-least\n number-in-range\n list-longer-than\n\n make-autofill-meta)\n\n(define form+combine\n  (make-keyword-procedure\n   (lambda (kws kw-args f action render . args)\n     (keyword-apply\n      form kws kw-args f action render args\n      #:combine (lambda (_k v1 v2)\n                  (if (pair? v1)\n                      (append v1 (list v2))\n                      (list v1 v2)))))))\n\n(define-syntax (form+submit stx)\n  (syntax-parse stx\n"}],"isError":false,"timestamp":1787820015680}]}
