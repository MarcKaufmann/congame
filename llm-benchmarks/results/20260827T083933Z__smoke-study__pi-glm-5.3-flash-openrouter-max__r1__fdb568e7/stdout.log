TTP round-trip. FIELDS is a list of \\\"name=value\\\" strings,\\n  ;; each sent as its own --data-urlencode argument.\\n  (define (roundtrip! method url fields)\\n    (bytes->string/utf-8\\n     (apply curl\\n            \\\"-X\\\" method\\n            \\\"-b\\\" (path->string jar) \\\"-c\\\" (path->string jar)\\n            (append\\n             (append-map (λ (f) (list \\\"--data-urlencode\\\" f)) fields)\\n             (list url)))))\", \"oldText\": \"  ;; One single HTTP round-trip.\\n  (define (roundtrip! method url data-field)\\n    (bytes->string/utf-8\\n     (cond\\n       [data-field\\n        (curl \\\"-X\\\" method \\\"--data-urlencode\\\" data-field\\n              \\\"-b\\\" (path->string jar) \\\"-c\\\" (path->string jar)\\n              url)]\\n       [else\\n        (curl \\\"-X\\\" method\\n              \\\"-b\\\" (path->string jar) \\\"-c\\\" (path->string jar)\\n              url)])))\"}, {\"newText\": \"  ;; Request a URL as a browser would: send the original request (with form\\n  ;; fields, if given), then keep GETting whatever the server points us at --\\n  ;; via Location headers or login interstitials -- but never re-submits the\\n  ;; form body on the way. Only the final response text is returned.\\n  (define (request! method url [fields null])\\n    (let go ([hops 10] [u url] [body fields])\\n      (when (zero? hops)\\n        (error 'request! \\\"too many redirects for ~a\\\" url))\\n      (define raw (roundtrip! method u body))\\n      (define next (or (location-of raw) (meta-refresh-of raw)))\\n      (cond\\n        [next (go (sub1 hops) next null)]\\n        [else raw])))\", \"oldText\": \"  ;; Request a URL as a browser would: send the original request (with form\\n  ;; body, if given), then keep GETting whatever the server points us at --\\n  ;; via Location headers or login interstitials -- but never re-submits the\\n  ;; form body on the way. Only the final response text is returned.\\n  (define (request! method url [data-field #f])\\n    (let go ([hops 10] [u url] [body data-field])\\n      (when (zero? hops)\\n        (error 'request! \\\"too many redirects for ~a\\\" url))\\n      (define raw (roundtrip! method u body))\\n      (define next (or (location-of raw) (meta-refresh-of raw)))\\n      (cond\\n        [next (go (sub1 hops) next #f)]\\n        [else raw])))\"}, {\"newText\": \"  (check! (and continue-target (non-empty-string? (second continue-target)))\\n          \\\"Continue link carries a continuation href\\\")\\n\\n  ;; Step 2: click Continue -> name entry form.\", \"oldText\": \"  (check! (and continue-target (non-empty-string? (second continue-target)))\\n          \\\"Continue link carries a continuation href\\\")\\n\\n  ;; Step 2: click Continue -> name entry form.\"}, {\"newText\": \"  ;; Step 3: empty submission must be rejected.\\n  (define rejected\\n    (body-of\\n     (request! \\\"POST\\\" action-url '(\\\"display-name=\\\" \\\"__tt=0\\\" \\\"__ft=0\\\"))))\\n  (check! (string-contains? rejected \\\"What is your name?\\\")\\n          \\\"empty submit stays on the name entry form\\\")\\n  (check! (string-contains? rejected \\\"Please enter your name.\\\")\\n          \\\"empty submit rejected with a validation error\\\")\\n  (check! (not (string-contains? rejected \\\"All done\\\"))\\n          \\\"empty submit does not reach the final page\\\")\\n\\n  ;; Step 4: whitespace-only submission must be rejected too.\\n  (define rejected-blank\\n    (body-of\\n     (request! \\\"POST\\\" action-url '(\\\"display-name=   \\\" \\\"__tt=0\\\" \\\"__ft=0\\\"))))\\n  (check! (not (string-contains? rejected-blank \\\"All done\\\"))\\n          \\\"whitespace-only name does not reach the final page\\\")\\n\\n  ;; Step 5: valid submission reaches the final page showing the name.\\n  (define tester \\\"Bench Tester\\\")\\n  (define finished\\n    (body-of\\n     (request! \\\"POST\\\" action-url\\n               (list (format \\\"display-name=~a\\\" tester)\\n                     \\\"__tt=0\\\" \\\"__ft=0\\\"))))\", \"oldText\": \"  ;; Step 3: empty submission must be rejected.\\n  (define rejected\\n    (body-of\\n     (request! \\\"POST\\\" action-url \\\"display-name=&__tt=0&__ft=0\\\")))\\n  (check! (string-contains? rejected \\\"What is your name?\\\")\\n          \\\"empty submit stays on the name entry form\\\")\\n  (check! (string-contains? rejected \\\"<ul class=\\\\\\\"errors\\\\\\\">\\\")\\n          \\\"empty submit rejected with a validation error\\\")\\n  (check! (not (string-contains? rejected \\\"All done\\\"))\\n          \\\"empty submit does not reach the final page\\\")\\n\\n  ;; Step 4: whitespace-only submission must be rejected too.\\n  (define rejected-blank\\n    (body-of\\n     (request! \\\"POST\\\" action-url \\\"display-name=%20%20%20&__tt=0&__ft=0\\\")))\\n  (check! (not (string-contains? rejected-blank \\\"All done\\\"))\\n          \\\"whitespace-only name does not reach the final page\\\")\\n\\n  ;; Step 5: valid submission reaches the final page showing the name.\\n  (define tester \\\"Bench Tester\\\")\\n  (define finished\\n    (body-of\\n     (request! \\\"POST\\\" action-url\\n               (format \\\"display-name=~a&__tt=0&__ft=0\\\" tester))))\"}],\"path\":\"/workspace/exercise.rkt\"}"}}
